{
  "mcpServers": {
    "crews": {
      "command": "uv",
      "args": ["run", "--project", "${CLAUDE_PLUGIN_ROOT}", "--frozen", "python", "${CLAUDE_PLUGIN_ROOT}/server.py"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "CREWS_HOME": "${CLAUDE_PLUGIN_DATA}",
        "CREWS_SEAT_PREFIX": "crews:",
        "TYPESAFE_API_KEY": "${user_config.typesafe_api_key}"
      }
    }
  }
}
